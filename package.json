{
  "name": "dsh-token-usage",
  "version": "0.1.0",
  "description": "Local token-usage calendar for DeepSeek Harness: per-day, per-model token consumption in Settings",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "tokens",
    "usage",
    "observability"
  ],
  "author": "SauronLee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SauronLee/dsh-token-usage.git"
  },
  "homepage": "https://github.com/SauronLee/dsh-token-usage#readme",
  "bugs": {
    "url": "https://github.com/SauronLee/dsh-token-usage/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "install-profile": "node scripts/install.mjs",
    "uninstall-profile": "node scripts/install.mjs --remove"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}